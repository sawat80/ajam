# ── AJAM deployment environment ───────────────────────────────
# Copy to ".env" and change every password before any real use.
# docker compose reads this file automatically.

COMPOSE_PROJECT_NAME=ajam

# Public entry point (the Nginx front door)
WEB_HTTP_PORT=8080

# ── OJS image ──
# latest stable 3.4 line; pin to a digest in production
OJS_IMAGE=pkpofficial/ojs:3_4_0-4
PKP_TOOL=ojs
PKP_VERSION=3_4_0-4
# hostname OJS believes it is served from (used for cookies / SSL CN)
SERVERNAME=localhost
# OJS public base URL — note the /ojs subpath behind Nginx
OJS_BASE_URL=http://localhost:8080/ojs
# 0 = run the web install wizard yourself; 1 = headless CLI install
PKP_CLI_INSTALL=0

# ── Database (MariaDB) ──
DB_IMAGE=mariadb:11.4
DB_HOST=db
DB_NAME=ojs
DB_USER=ojs
DB_PASSWORD=change-me-ojs-db
DB_ROOT_PASSWORD=change-me-root
