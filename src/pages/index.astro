---
import Base from '../layouts/Base.astro';
import { journal, subjects, ojs, indexing } from '../data/site';
import { u } from '../lib/url';
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow eyebrow--hero">{journal.publisher} · {journal.institutionShort}</p>
      <h1>{journal.title}</h1>
      <p class="lead hero__lead">{journal.tagline}</p>
      <div class="hero__meta">
        <span class="chip">ISSN {journal.issnOnline}</span>
        <span class="chip">{journal.accessModel.split('—')[0].trim()}</span>
        <span class="chip">{journal.reviewModel}</span>
        <span class="chip">{journal.frequency.split('(')[0].trim()}</span>
      </div>
      <div class="hero__cta">
        <a class="btn btn--gold" href={ojs.submit}>Submit Your Manuscript →</a>
        <a class="btn btn--ghost btn--ghost-hero" href={u('/aims-and-scope/')}>Read Aims &amp; Scope</a>
      </div>
    </div>
  </section>

  <!-- AT A GLANCE -->
  <section class="section">
    <div class="container">
      <div class="grid grid--4">
        <div class="card card--accent">
          <h3>Free to publish</h3>
          <p class="muted">Diamond open access. No submission or article-processing charges — ever.</p>
        </div>
        <div class="card card--accent">
          <h3>Rigorous review</h3>
          <p class="muted">Double-blind peer review by an international board of specialists.</p>
        </div>
        <div class="card card--accent">
          <h3>Global reach</h3>
          <p class="muted">Indexed and openly licensed under {journal.license} for maximum visibility.</p>
        </div>
        <div class="card card--accent">
          <h3>Fast & fair</h3>
          <p class="muted">Transparent OJS-managed workflow with clear timelines for authors.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT / SCOPE -->
  <section class="section section--alt">
    <div class="container about">
      <div>
        <p class="eyebrow">About the journal</p>
        <h2>Applied mathematics from Ouargla to the world</h2>
        <p>
          The {journal.title} ({journal.shortTitle}) is a peer-reviewed, open-access journal
          published by the {journal.publisher} at {journal.institution}, {journal.country}.
          We publish original research, high-quality surveys, and significant computational
          studies across the breadth of applied and computational mathematics.
        </p>
        <p>
          {journal.shortTitle} is committed to disseminating mathematical research that bridges
          theory and real-world application — serving the Algerian and international research
          community without financial barriers to authors or readers.
        </p>
        <p>
          <a class="btn btn--primary" href={u('/for-authors/')}>Author guidelines</a>
        </p>
      </div>
      <aside class="factbox">
        <h3>Journal facts</h3>
        <dl>
          <dt>Publisher</dt><dd>{journal.publisher}</dd>
          <dt>Institution</dt><dd>{journal.institution}</dd>
          <dt>Frequency</dt><dd>{journal.frequency}</dd>
          <dt>Language</dt><dd>{journal.language}</dd>
          <dt>Peer review</dt><dd>{journal.reviewModel}</dd>
          <dt>Access</dt><dd>{journal.accessModel}</dd>
          <dt>License</dt><dd>{journal.license}</dd>
        </dl>
      </aside>
    </div>
  </section>

  <!-- SUBJECT AREAS -->
  <section class="section">
    <div class="container">
      <p class="eyebrow">Subject areas</p>
      <h2>What we publish</h2>
      <p class="lead">AJAM welcomes submissions across applied and computational mathematics, including:</p>
      <div class="grid grid--4 subjects">
        {subjects.map((s) => (
          <div class="subject">
            <span class="subject__icon" aria-hidden="true">{s.icon}</span>
            <span>{s.name}</span>
          </div>
        ))}
      </div>
      <p style="margin-top:1.5rem"><a href={u('/aims-and-scope/')}>See full aims &amp; scope →</a></p>
    </div>
  </section>

  <!-- SUBMIT CTA -->
  <section class="cta-band">
    <div class="container cta-band__inner">
      <div>
        <h2>Ready to submit?</h2>
        <p>Create an account on our Open Journal Systems platform and follow the five-step submission wizard.</p>
      </div>
      <div class="cta-band__btns">
        <a class="btn btn--gold" href={ojs.submit}>Submit manuscript</a>
        <a class="btn btn--ghost btn--ghost-hero" href={ojs.register}>Register</a>
      </div>
    </div>
  </section>

  <!-- INDEXING STRIP -->
  <section class="section">
    <div class="container center">
      <p class="eyebrow">Visibility</p>
      <h2>Indexing &amp; abstracting</h2>
      <p class="lead" style="margin-inline:auto">
        {journal.shortTitle} content is openly discoverable. Currently indexed in:
      </p>
      <div class="indexrow">
        {indexing.current.map((i) => <span class="tag">{i.name}</span>)}
      </div>
      <p class="muted" style="margin-top:1rem">Applications submitted to DOAJ, zbMATH, MathSciNet, Scopus &amp; Crossref.</p>
      <p><a href={u('/indexing/')}>Indexing details →</a></p>
    </div>
  </section>
</Base>

<style>
  .hero {
    background:
      radial-gradient(900px 400px at 85% -10%, rgba(200,169,106,.3), transparent),
      radial-gradient(700px 500px at 0% 120%, rgba(35,122,91,.5), transparent),
      var(--green-900);
    color: #fff; padding-block: clamp(3rem, 8vw, 6rem);
    border-bottom: 4px solid var(--sand-500);
  }
  .hero h1 { color: #fff; max-width: 18ch; }
  .hero__lead { color: var(--sand-100); }
  .eyebrow--hero { color: var(--sand-300); }
  .hero__meta { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.4rem 0 1.8rem; }
  .chip {
    background: rgba(255,255,255,.1); border: 1px solid rgba(200,169,106,.5);
    color: #fff; padding: .3rem .8rem; border-radius: 999px; font-size: .85rem; font-weight: 600;
  }
  .hero__cta { display: flex; gap: .8rem; flex-wrap: wrap; }
  .btn--ghost-hero { color: #fff; border-color: var(--sand-300); }
  .btn--ghost-hero:hover { background: rgba(255,255,255,.12); color: #fff; }

  .about { display: grid; grid-template-columns: 1.6fr 1fr; gap: 2.5rem; align-items: start; }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } }
  .factbox { background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow); }
  .factbox h3 { margin-top: 0; }
  .factbox dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: .4rem 1rem; }
  .factbox dt { font-weight: 700; color: var(--green-800); font-size: .9rem; }
  .factbox dd { margin: 0; font-size: .9rem; color: var(--ink-soft); }

  .subjects { margin-top: 1.5rem; }
  .subject {
    display: flex; align-items: center; gap: .8rem; padding: 1rem;
    background: var(--bg-alt); border: 1px solid var(--line); border-radius: var(--radius);
    font-weight: 600; font-size: .95rem;
  }
  .subject__icon {
    flex: 0 0 auto; width: 40px; height: 40px; display: grid; place-items: center;
    background: var(--green-100); color: var(--green-700); border-radius: 8px;
    font-family: var(--font-serif); font-size: 1.3rem;
  }

  .cta-band { background: var(--green-700); color: #fff; padding-block: 2.5rem; }
  .cta-band h2 { color: #fff; margin: 0; }
  .cta-band p { color: var(--green-100); margin: .4rem 0 0; }
  .cta-band__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .cta-band__btns { display: flex; gap: .7rem; flex-wrap: wrap; }

  .indexrow { display: flex; gap: .6rem; flex-wrap: wrap; justify-content: center; margin-top: 1rem; }
</style>
