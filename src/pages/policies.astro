    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    display: inline-block;
    min-width: 18rem;
    max-width: 100%;
  }

  .toc__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin: 0 0 0.5rem;
  }

  .toc__list {
    margin: 0;
    padding-left: 1.25rem;
  }

  .toc__list li {
    margin: 0.25rem 0;
    font-size: 0.9rem;
  }

  .toc__list a {
    text-decoration: none;
    color: var(--color-accent, #1d4ed8);
  }

  .toc__list a:hover {
    text-decoration: underline;
  }
</style>
